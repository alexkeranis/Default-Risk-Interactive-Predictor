  "engineered_features": {
    "bnpl_dti": "Outstanding BNPL debt / annual income. Core affordability and leverage measure. Income is floored, so zero income means maximum leverage, never zero.",
    "ticket_to_monthly_income": "Typical purchase size / monthly income. How large each new instalment plan is relative to the cash flow that must service it.",
    "debt_per_loan": "Average balance per active plan. Separates a few large commitments from many small ones; 0 when there are no active plans.",
    "loan_stacking": "Flag for 3 or more concurrent BNPL plans. Stacking across providers is a known stress signal that bureau data often misses.",
    "subprime": "Credit score below 580 (FICO 'poor' band). A non-linear threshold a linear model cannot represent from the raw score.",
    "near_prime": "Credit score 580-669 (FICO 'fair' band).",
    "unstable_income": "Student or unemployed: income that is irregular or transfer-based.",
    "late_x_dti": "Late payment history x leverage. Past delinquency matters more when the customer is already stretched.",
    "unstable_x_dti": "Unstable income x leverage. Debt is riskier when income is unreliable.",
    "late_x_subprime": "Late payment history x subprime score: compounding delinquency signals.",
    "log_income": "log(1 + income). Diminishing marginal effect of income on repayment capacity.",
    "log_debt": "log(1 + BNPL debt). Diminishing marginal effect of balance size.",
    "young_borrower": "Age under 25: a proxy for a thin credit file."
  },
